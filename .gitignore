# ---------------------------------------------------------------------
# Werkmap voor alles wat niet publiek mag: analyses, planning, klant-
# documenten, aantekeningen. Blijft binnen de repo-map zodat het bij
# elkaar staat, maar gaat nooit mee in een commit.
# ---------------------------------------------------------------------
/.local/

# ---------------------------------------------------------------------
# Vertrouwelijk materiaal — mag nooit in deze publieke repo terechtkomen
# ---------------------------------------------------------------------
# Telegram-exports, deelnemerslijsten, het organisatiehandboek en alles
# wat naar een concrete locatie of persoon te herleiden is.

*.vertrouwelijk.*
/analyse/
/private/
telegram-export*
*deelnemers*
*ledenlijst*

# Organisatiedocumenten en bijlagen van de klant
*.pdf
*.docx
*.doc
!docs/**/*.pdf

# Foto's en video's uit de groepen (sleutelposities, installaties)
photo_*.jpg
video_*.mp4
/Groepen/

# ---------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------
appsettings.*.json
!appsettings.json
!appsettings.Development.template.json
*.env
.env.*
secrets.json
*.pfx
*.pem

# ---------------------------------------------------------------------
# .NET / Angular
# ---------------------------------------------------------------------
bin/
obj/
node_modules/
dist/
.vs/
.vscode/
*.user
TestResults/
# Angular specific
/dist/
/out-tsc/
/tmp/
/coverage/
/e2e/test-output/
/.angular/
.angular/

# Node modules and dependency files
/node_modules/
/package-lock.json
/yarn.lock

# Environment files
/.env

# Angular CLI and build artefacts
/.angular-cli.json
/.ng/

# TypeScript cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------
# Frontend-build in de API
# ---------------------------------------------------------------------
# De PWA wordt hierin gebouwd (zie deploy/Dockerfile.api). Lokaal komt
# die map vol te staan zodra je de build ernaartoe draait; gecommit zou
# hij een verouderde frontend meeleveren die niemand terugvindt.
/src/Api/wwwroot/*
!/src/Api/wwwroot/.gitkeep
